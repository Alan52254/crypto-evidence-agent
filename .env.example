# 複製成 .env 並填入自己的值；.env 已由 .gitignore 排除。

# ── 1. 核心模型 API Key (必須) ──
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-2.5-flash
# 雙 Key 自動輪替 (可選，填入第 2 把 Key 可將 RPM 頻率限制翻倍)
# GEMINI_API_KEY_2=your-second-gemini-api-key

# ── 2. 美國聯準會 FRED 宏觀數據 API Key (建議申請，免費) ──
# 申請網址：https://fred.stlouisfed.org/docs/api/api_key.html
FRED_API_KEY=your-fred-api-key

# ── 3. CoinGecko 即時行情 API Key (可選，填入可避免公共頻率限制) ──
# COINGECKO_API_KEY=your-coingecko-api-key

# ── 4. AWS Bedrock (可選，設 MODEL_PROVIDER=bedrock 啟用) ──
# Bedrock API Key (非 IAM，從 AWS Console 取得)
# BEDROCK_API_KEY=your-bedrock-api-key
# BEDROCK_REGION=us-east-1
# BEDROCK_MODEL=anthropic.claude-3-5-sonnet-20241022-v2:0

# ── 5. 備用模型 Groq (可選) ──
# GROQ_API_KEY=your-groq-api-key
# GROQ_MODEL=llama-3.3-70b-versatile

# ── 模型選擇 ──
# MODEL_PROVIDER=gemini  (預設：gemini > bedrock > groq)
# MODEL_PROVIDER=bedrock (使用 AWS Bedrock Claude)
# MODEL_PROVIDER=groq    (使用 Groq LLaMA)
