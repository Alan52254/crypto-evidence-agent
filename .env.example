# 複製成 .env 並填入自己的值；.env 已由 .gitignore 排除。
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-3.6-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
GEMINI_EMBEDDING_DIMENSIONS=768
# HOYABIT_DATASET_DIR=path/to/HOYA_BIT_crypto_market_dataset

# Groq (alternative model provider — faster, smaller context)
# GROQ_API_KEY=your-groq-api-key
# GROQ_MODEL=llama-3.3-70b-versatile

# ── 模型選擇 ──
# MODEL_PROVIDER=gemini  (預設：gemini > bedrock > groq)
# MODEL_PROVIDER=bedrock (使用 AWS Bedrock Claude)
# MODEL_PROVIDER=groq    (使用 Groq LLaMA)

# ── 6. Athena Data Warehouse (可選，歷史回測與統計分析) ──
# S3_DATA_BUCKET=hoyabit-data-warehouse-<account_id>
# ATHENA_DATABASE=hoyabit_market
# ATHENA_WORKGROUP=primary
# ATHENA_OUTPUT_LOCATION=s3://hoyabit-data-warehouse-<account_id>/athena-results/
# ATHENA_REGION=us-east-1

# ── 7. Kinesis / Firehose 即時串流 (可選) ──
# AWS_REGION=us-west-2
# KINESIS_STREAM_NAME=ggg
# FIREHOSE_STREAM_NAME=hoyabit-market-firehose

# ── 8. DynamoDB Cache (可選，Session Memory + Query Cache) ──
# DYNAMODB_REGION=us-west-2
