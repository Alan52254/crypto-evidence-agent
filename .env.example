# 複製成 .env 並填入自己的值；.env 已由 .gitignore 排除。

# ── 1. 核心模型 API Key (必須 — 擇一) ──

# 選項 A: AWS Bedrock Claude (推薦，按量計費無 rate limit)
# Bedrock API Key (非 IAM Bearer Token，從 AWS Console → Bedrock → API keys 取得)。
# BEDROCK_MODEL 是 inference profile ID（不是裸模型名稱）——
# AWS Bedrock 要求 on-demand 呼叫必須走 inference profile routing。
# 如果 AWS 更新 profile 命名規則，需要在這裡同步修改。
MODEL_PROVIDER=bedrock
BEDROCK_API_KEY=your-bedrock-api-key
BEDROCK_REGION=us-east-1
BEDROCK_MODEL=us.anthropic.claude-sonnet-4-6

# 選項 B: Google Gemini (免費層，有 RPM 限制)
# MODEL_PROVIDER=gemini
# GEMINI_API_KEY=your-gemini-api-key
# GEMINI_MODEL=gemini-2.5-flash
# 雙 Key 自動輪替 (可選，填入第 2 把 Key 可將 RPM 頻率限制翻倍)
# GEMINI_API_KEY_2=your-second-gemini-api-key

# ── 2. 美國聯準會 FRED 宏觀數據 API Key (建議申請，免費) ──
# 申請網址：https://fred.stlouisfed.org/docs/api/api_key.html
FRED_API_KEY=your-fred-api-key

# ── 3. CoinGecko 即時行情 API Key (可選，填入可避免公共頻率限制) ──
# COINGECKO_API_KEY=your-coingecko-api-key

# ── 4. 備用模型 Groq (可選，MODEL_PROVIDER=bedrock 時不會被用到) ──
# GROQ_API_KEY=your-groq-api-key
# GROQ_MODEL=llama-3.3-70b-versatile
